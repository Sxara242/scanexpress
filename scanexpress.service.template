[Unit]
Description=ScanExpress Scanner Manager
After=network.target

[Service]
Type=simple
User=scanexpress
Group=scanexpress
WorkingDirectory=/opt/scanexpress
Environment="SCANEXPRESS_CONFIG_FILE=/etc/scanexpress.conf"
Environment="SCANEXPRESS_DATA_DIR=/var/lib/scanexpress"
# Secure cookies are correct when the browser reaches ScanExpress over HTTPS
# (for example through Tailscale Serve). Set to 0 only for an intentional
# plain-HTTP deployment.
Environment="SCANEXPRESS_SECURE_COOKIES=1"
# Physical-button events use a local Unix socket. This socket is not reachable
# through the web UI or reverse proxy.
Environment="SCANEXPRESS_HARDWARE_SOCKET=/run/scanexpress/hardware-events.sock"
# Canon CanoScan LiDE 400 reference mapping. Other scanners should override it.
Environment="SCANEXPRESS_HARDWARE_TARGET_MAP=5=document,6=finish,2=batch,1=ignore,3=ignore"
Environment="SCANEXPRESS_HARDWARE_DEBOUNCE_SECONDS=1.5"
RuntimeDirectory=scanexpress
RuntimeDirectoryMode=0750
ExecStartPre=/opt/scanexpress/.venv/bin/python -m storage init
ExecStart=/opt/scanexpress/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - wsgi:app
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
